# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Precedence: CLI flag > environment variable > .env > built-in default.

# --- Secrets ---------------------------------------------------------------
# Only the key for the provider you use is needed. Never commit a real key.
# Used for answers when RAG_LLM_PROVIDER=auto (default) or anthropic.
ANTHROPIC_API_KEY=
# Used for answers when RAG_LLM_PROVIDER=auto/openai, and for RAG_EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
# (Keep comments on their own lines: "KEY=   # note" would make the note the value.)

# --- Storage ---------------------------------------------------------------
RAG_DATA_DIR=.rag_data
RAG_DEFAULT_COLLECTION=default
RAG_MAX_FILE_MB=50
# Maximum number of files in one HTTP upload request
RAG_MAX_UPLOAD_FILES=20

# --- Chunking --------------------------------------------------------------
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=140
RAG_MIN_CHUNK_CHARS=20

# --- Embeddings ------------------------------------------------------------
# fastembed = local ONNX model (downloads once; documents stay local)
# openai    = hosted OpenAI embeddings (sends document text to OpenAI at ingest time)
# hashing   = offline test embedder (low quality)
RAG_EMBEDDING_PROVIDER=fastembed
# Default depends on the provider: BAAI/bge-small-en-v1.5 | text-embedding-3-small.
# Changing the embedding model requires re-ingesting existing collections.
# RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BATCH_SIZE=32
# RAG_MODEL_CACHE_DIR=.cache/models

# --- Retrieval -------------------------------------------------------------
# dense | bm25 | hybrid  (hybrid helps identifier-heavy corpora; see docs/06_EVALUATION.md)
RAG_RETRIEVAL_MODE=dense
RAG_TOP_K=5
RAG_CANDIDATE_POOL=20
RAG_RRF_K=60
# Abstain without calling the LLM if the best dense cosine is below this.
# Model-specific. Unset = 0.50 for bge-small (calibrated), otherwise 0 (disabled) until you
# calibrate it: `rag eval` prints a suggested value. Setting 0 explicitly disables it.
# RAG_MIN_RELEVANCE=

# --- Reranking -------------------------------------------------------------
# none | cross_encoder
RAG_RERANKER=none
RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Generation ------------------------------------------------------------
# auto (default) = whichever key above is set (Anthropic first); neither -> retrieval-only.
# anthropic | openai | none force a choice (use anthropic for `ant auth login` profiles).
RAG_LLM_PROVIDER=auto
# Default depends on the provider: claude-opus-5-5 | gpt-5.5
# RAG_LLM_MODEL=
# low | medium | high | xhigh | max
# Anthropic only
RAG_LLM_EFFORT=low
RAG_LLM_MAX_TOKENS=4096
RAG_LLM_TIMEOUT_S=60
RAG_LLM_MAX_RETRIES=2
# Only sent when set; current Opus/Sonnet models reject sampling parameters.
# RAG_LLM_TEMPERATURE=0.0
# Server-side refusal fallback (first-party Claude API only; set false for Bedrock/Vertex/proxies)
RAG_ANTHROPIC_SERVER_FALLBACK=true
RAG_MAX_CONTEXT_CHARS=12000
# Let API clients (the web UI) send their own Anthropic/OpenAI key per request.
# Set false on shared deployments where only the server's key may be used.
RAG_ALLOW_CLIENT_LLM_KEYS=true

# --- OpenAI -----------------------------------------------------------------
# Azure OpenAI or any OpenAI-compatible server (e.g. Ollama: http://localhost:11434/v1)
# RAG_OPENAI_BASE_URL=
# Reasoning models only (none|minimal|low|medium|high|xhigh); unset = model default.
# RAG_OPENAI_REASONING_EFFORT=low
RAG_MAX_QUESTION_CHARS=2000

# --- Agentic corrective retry (see ADR-009) -------------------------------
RAG_QUERY_REWRITE=false
RAG_MAX_REWRITES=3

# --- Observability ---------------------------------------------------------
RAG_LOG_LEVEL=INFO
# json | text
RAG_LOG_FORMAT=text
# Log document/question text. Keep false unless debugging with non-sensitive data.
RAG_LOG_CONTENT=false
